{
  "schemaVersion": 3,
  "description": "Matriz de exclusiones del motor DeltaPack Dual-Engine (filosofia Cero Ruido). Editar con cuidado: estas reglas determinan que se considera ruido del sistema vs. cambios reales de la aplicacion capturada.",
  "captureSettings": {
    "allowManagedRuntimeUpdates": false,
    "allowAuditOnlyDeletions": false,
    "includeBundledOneDrive": false,
    "actionAwareInjector": false,
    "fileScanMaxAttempts": 3,
    "fileScanRetryDelayMs": 200,
    "useVssScanFallback": true,
    "additionalFileRoots": [],
    "additionalRegistryTargets": [],
    "notes": [
      "Activa allowManagedRuntimeUpdates solo cuando Edge/WebView2 sea una dependencia intencional del instalador capturado.",
      "EdgeWebView\\Application\\SetupMetrics se excluye siempre porque contiene telemetria de instalacion, no binarios necesarios del runtime.",
      "allowAuditOnlyDeletions=false impide marcar como listo un paquete con tombstones accionables cuyo inyector no consume Deletions_*.json; filesystemAuditOnly y registryAuditOnly son evidencia y no bloquean por si solas.",
      "includeBundledOneDrive=false separa OneDrive cuando Office u otro instalador lo actualiza incidentalmente; capturalo como paquete independiente o habilita la opcion de forma explicita.",
      "actionAwareInjector=false mantiene packageReady=false cuando Actions_*.json schema 2 exige registrar catalogos o controladores offline. Habilitalo solo si el inyector consume el schema de acciones.",
      "fileScanMaxAttempts y fileScanRetryDelayMs reintentan lecturas que cambian mientras se calcula SHA256; useVssScanFallback rescata desde una instantanea coherente del volumen.",
      "additionalFileRoots acepta rutas absolutas y variables de entorno, por ejemplo %SystemDrive%\\Autodesk o D:\\Aplicaciones.",
      "additionalRegistryTargets acepta objetos { hive: HKLM|HKCU, path: ruta, label: texto opcional }.",
      "fileDeletionAuditRules clasifica eliminaciones ambientales conocidas como evidencia no destructiva; sus expresiones regulares se validan al iniciar.",
      "registryDeletionAuditRules conserva como auditoria las eliminaciones de ramas protegidas del Registro, sin impedir que altas o modificaciones legitimas del instalador se capturen."
    ]
  },
  "fileDeletionAuditRules": [
    {
      "category": "MANTENIMIENTO TRANSITORIO .NET",
      "patterns": [
        "^Windows\\\\Microsoft\\.NET\\\\Framework(?:64)?\\\\v[0-9.]+\\\\FXUpdate\\.dat$"
      ],
      "reason": "FXUpdate.dat es un marcador transitorio de mantenimiento de .NET y no debe convertirse en una eliminacion destructiva del paquete."
    },
    {
      "category": "MARCADORES TRANSITORIOS DE CACHE DE USUARIO",
      "patterns": [
        "^Users\\\\Default\\\\AppData\\\\Local\\\\Microsoft\\\\Internet Explorer\\\\CacheStorage\\\\\\.inUse$"
      ],
      "reason": ".inUse es un marcador efimero de la cache de Internet Explorer; su desaparicion no pertenece al instalador capturado ni debe ejecutarse como tombstone."
    }
  ],
  "registryDeletionAuditRules": [
    {
      "category": "PUBLICADORES DE EVENTOS DEL SISTEMA",
      "paths": [
        "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Publishers"
      ],
      "reason": "Durante una instalacion pueden rotar registros de proveedores ETW administrados por Windows o seguridad. Sus altas y modificaciones siguen capturandose, pero una desaparicion no correlacionada nunca debe convertirse en una eliminacion destructiva dentro del REG offline."
    }
  ],
